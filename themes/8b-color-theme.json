		"inlineChat.border": "#00ffff",
		"inlineChat.shadow": "#ff00ff44",
		"inlineChatInput.border": "#ff00ff",
		"inlineChatInput.background": "#263238",
		"inlineChatInput.placeholderForeground": "#546e7a",
		"inlineChatDiff.inserted": "#00ff8844",
		"inlineChatDiff.removed": "#ff005544",

		// === PANELS & TERMINALS ===
		"panel.background": "#1e272c",
