		"terminal.ansiMagenta": "#ff00ff",
		"terminal.ansiBrightCyan": "#00ffff",
		"terminal.ansiBrightMagenta": "#ff00ff",

		// === NOTIFICATIONS (Get their attention!) ===
		"notificationCenter.border": "#ff00ff",
		"notificationCenterHeader.background": "#1a2327",
		"notificationCenterHeader.foreground": "#00ffff",
		"notifications.background": "#263238",
