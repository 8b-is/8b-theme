		"notificationsErrorIcon.foreground": "#ff0055",
		"notificationsWarningIcon.foreground": "#ffaa00",
		"notificationsInfoIcon.foreground": "#00ffff",

		// === BADGES & COUNTERS ===
		"badge.background": "#ff00ff",
		"badge.foreground": "#000000",

		// === STATUS BAR ===
		"statusBar.background": "#1a2327",
		"statusBar.foreground": "#00ffff",
		"statusBar.border": "#ff00ff",
		"statusBar.debuggingBackground": "#ff00ff",
		"statusBar.debuggingForeground": "#000000",
		"statusBar.noFolderBackground": "#2d1b3d",
		"statusBarItem.prominentBackground": "#ff00ff",
