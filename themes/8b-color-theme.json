		"chat.editedFileForeground": "#ffaa00",
		"chat.linesAddedForeground": "#00ff88",
		"chat.linesRemovedForeground": "#ff0055",
		"chat.checkpointSeparator": "#00ffff",

		// === INLINE CHAT (Code suggestions & quick edits) ===
