		"gitDecoration.modifiedResourceForeground": "#ffaa00",
		"gitDecoration.deletedResourceForeground": "#ff0055",
		"gitDecoration.untrackedResourceForeground": "#00ffff",
		"gitDecoration.ignoredResourceForeground": "#546e7a",
		"gitDecoration.conflictingResourceForeground": "#ff00ff",

		// === BREADCRUMBS ===
		"breadcrumb.foreground": "#b0bec5",
		"breadcrumb.background": "#263238",
		"breadcrumb.focusForeground": "#00ffff",
		"breadcrumb.activeSelectionForeground": "#ff00ff",
		"breadcrumbPicker.background": "#1e272c"
