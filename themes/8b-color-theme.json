{
	"name": "8b",
	"colors": {
		// === EDITOR CORE ===
		"editor.background": "#263238",
		"editor.foreground": "#eeffff",
		"editor.lineHighlightBackground": "#2a373e",
		"editorCursor.foreground": "#ff00ff",
		"editorWhitespace.foreground": "#3d4f56",

		// === SIDEBAR & ACTIVITY BAR ===
		"sideBar.background": "#1e272c",
		"sideBar.foreground": "#b0bec5",
		"sideBarTitle.foreground": "#00ffff",
		"activityBar.background": "#1a2327",
		"activityBar.foreground": "#00ffff",
		"activityBarBadge.background": "#ff00ff",
